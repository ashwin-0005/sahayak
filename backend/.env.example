PORT=4000
# Production refuses to boot with the default or any secret < 32 chars.
JWT_SECRET=change-me-to-a-long-random-secret-in-production
# Production refuses to boot with "*". Set the exact frontend origin, e.g.
# CORS_ORIGIN=https://sahayak-seven-phi.vercel.app
CORS_ORIGIN=*
DB_PATH=./data/sahayak.db
